# Production / nightly build settings. Read automatically by `vite build`.
# No secrets belong in this file — it is committed. Anything Vite substitutes at
# build time ends up readable in the JS bundle.

# ─── SSO landing (portal hand-off) ──────────────────────────────────────────
#
# The app has no login form. It is opened by the portal with the identity
# context on the query string and exchanges it for a session:
#
#   /OpentelemetryApp/?role=superadministrator&tenantCode=Primary
#                     &lang=en&refKey=qgit6fmspn7ebu
#
# VITE_SSO_MOCK=true  → the "login by SSO" call is answered by a hardcoded
#   in-file response (src/auth/authService.js → mockSsoResponse) that echoes the
#   role from the URL. This is the current default so the landing → role →
#   Administrator/Operator flow works before the backend endpoint exists.
#
# Set it to false once the backend is up. Nothing else changes.
VITE_SSO_MOCK=true

# Where the real call goes. Defaults to our own backend, which holds the
# tiotSSO bearer token and proxies to
# /tiotSSO/1.0.0/sso-role-validation/validateRole. Do NOT point this straight at
# tiotSSO: that call needs a bearer token, and anything reachable from the
# browser is readable by the user.
# VITE_SSO_API_URL=/OpentelemetryService/api/auth/login-by-sso
