{
  "name": "observability-ui",
  "private": false,
  "version": "3.0.1",
  "type": "module",
  "main": "./dist/observability-ui.js",
  "exports": {
    ".": {
      "import": "./dist/observability-ui.js",
      "default": "./dist/observability-ui.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:wc": "vite build --mode wc",
    "pack:wc": "npm run build:wc && npm pack && node -e \"const fs=require('fs');const f=fs.readdirSync('.').find(x=>x.startsWith('observability-ui-')&&x.endsWith('.tgz'));if(f)fs.renameSync(f,'observability-ui.tgz')\"",
    "pretest": "node -e \"require('fs').mkdirSync('coverage/OpentelemetryApp',{recursive:true})\"",
    "test": "node --import ./test/support/register.mjs --enable-source-maps --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/OpentelemetryApp/lcov.info \"test/**/*.test.mjs\"",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@grafana/data": "11.1.13",
    "@grafana/runtime": "11.1.13",
    "@grafana/scenes": "5.6.2",
    "@grafana/schema": "11.1.13",
    "@grafana/ui": "11.1.13",
    "dompurify": "3.4.14",
    "handlebars": "4.7.9",
    "marked": "12.0.2",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "jsdom": "^26.1.0",
    "vite": "^5.2.0",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  }
}
